# Docker Compose & Deployment Environment Variables
# Copy to .env if you want to override defaults (e.g. on AWS EC2)

# Port exposed on host for the Nginx React UI + API reverse proxy (set to 80 on EC2 if desired)
UI_PORT=3000
MOBILE_PORT=3001

# Backend configuration
BACKEND_PORT=4000
MONGODB_URI=mongodb://mongodb:27017/sa_zalo_ott
AUTH_JWT_SECRET=sa-zalo-ott-change-this-secret-at-least-32-chars-2026

# Frontend build-time GraphQL URL (keep as /graphql when served behind Nginx)
REACT_APP_GRAPHQL_URL=/graphql
