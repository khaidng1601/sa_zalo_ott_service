{
  "expo": {
    "name": "Chatter OTT",
    "slug": "chatter-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#0068FF",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "Chatter cần quyền truy cập Camera để chụp ảnh và quay video gửi trong cuộc trò chuyện.",
        "NSPhotoLibraryUsageDescription": "Chatter cần quyền truy cập Thư viện ảnh để chọn hình ảnh, video và ảnh đại diện.",
        "NSMicrophoneUsageDescription": "Chatter cần quyền truy cập Micro khi quay video."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0068FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
