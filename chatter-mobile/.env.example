# ============================================================================
# Chatter Mobile (Expo Go) — Backend Connection Configuration
# ============================================================================
# Copy this file to `.env` inside `chatter-mobile/`:
#   cp .env.example .env
#
# Option A — Local Docker Stack via Wi-Fi LAN (Recommended for Physical Phone):
# Replace 192.168.1.100 with your computer's Wi-Fi IPv4 address (`ipconfig` / `ifconfig`).
# Port 3000 routes /graphql, /uploads, and /socket.io/ through Nginx to chatter-backend:4000.
# (If left blank, Chatter Mobile automatically detects your computer's LAN IP from Expo Go!)
EXPO_PUBLIC_API_URL=

# Option B — Deployed AWS EC2 / Public Endpoint:
# EXPO_PUBLIC_API_URL=http://<EC2_PUBLIC_IP>:3000

# Optional fine-grained overrides (defaults derive automatically from EXPO_PUBLIC_API_URL):
# EXPO_PUBLIC_GRAPHQL_URL=http://192.168.1.100:3000/graphql
# EXPO_PUBLIC_WS_URL=http://192.168.1.100:3000
